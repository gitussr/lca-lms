# LCA LMS frontend — environment configuration
#
# Copy to .env.local for local development. Never commit real values.
# Vite only exposes variables prefixed with VITE_ to client code.

# Base path the API client prepends to every request. Same-origin by default
# (the dev server and the production reverse proxy both route /api to the
# backend), so you rarely need to change this.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api during `npm run dev`.
# Must match the backend HOST/PORT (backend/.env).
VITE_API_PROXY_TARGET=http://localhost:3000
