{
  "name": "@lca-lms/backend",
  "version": "0.0.0",
  "private": true,
  "description": "LCA LMS API — modular monolith (Fastify + TypeScript).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --import ./src/test/setup.ts --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import tsx --import ./src/test/setup.ts --experimental-test-coverage --test-coverage-exclude=\"**/*.test.ts\" --test \"src/**/*.test.ts\"",
    "db:migrate:create": "node-pg-migrate create -m migrations -j ts --",
    "db:migrate:up": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts up",
    "db:migrate:down": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts down",
    "seed:admin": "node --env-file-if-exists=.env --import tsx src/db/seed-admin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "argon2": "^0.45.1",
    "fastify": "^5.1.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
