# LCA LMS backend — environment configuration
# Copy to .env for local development. Never commit .env.
# A schema-validated loader replaces this shim in F-004.

# development | test | production
NODE_ENV=development

# HTTP server bind address and port
HOST=0.0.0.0
PORT=3000

# Logger level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Allowed browser origins for CORS (comma-separated). Matches the frontend dev server.
CORS_ORIGIN=http://localhost:5173
