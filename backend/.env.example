# LCA LMS backend — environment configuration
# Copy to .env for local development. Never commit .env.
# A schema-validated loader replaces this shim in F-004.

# development | test | production
NODE_ENV=development

# HTTP server bind address and port
HOST=0.0.0.0
PORT=3000

# Logger level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Allowed browser origins for CORS (comma-separated). Matches the frontend dev server.
CORS_ORIGIN=http://localhost:5173

# Postgres connection string. Required in production (no default).
# Development/test fall back to these same local placeholder credentials when
# unset — not secrets, just a convention F-008's Docker Compose setup matches.
DATABASE_URL=postgresql://lca_lms:lca_lms_dev@localhost:5432/lca_lms_dev
