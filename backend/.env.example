# LCA LMS backend — environment configuration
#
# Copy to .env for local development. Never commit .env.
#
# Every variable here is validated against a schema at boot (F-004,
# src/shared/config.ts) — an invalid value refuses the app to start with a
# clear error instead of failing confusingly later. staging and production
# are treated as one strict profile: DATABASE_URL and CORS_ORIGIN have no
# default there and must be set explicitly.

# development | test | staging | production
NODE_ENV=development

# HTTP server bind address and port. PORT must be an integer, 1-65535.
HOST=0.0.0.0
PORT=3000

# Logger level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Allowed browser origins for CORS (comma-separated). Matches the frontend dev
# server in development. Required (no default) in staging/production.
CORS_ORIGIN=http://localhost:5173

# Postgres connection string (postgres:// or postgresql://).
# Required (no default) in staging/production — the app refuses to start
# there without one, and refuses this exact local placeholder too.
# Development/test fall back to these same local placeholder credentials when
# unset — not secrets, just a convention F-008's Docker Compose setup matches.
DATABASE_URL=postgresql://lca_lms:lca_lms_dev@localhost:5432/lca_lms_dev
