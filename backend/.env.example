# LCA LMS backend — environment configuration
#
# Copy to .env for local development. Never commit .env.
#
# Every variable here is validated against a schema at boot (F-004,
# src/shared/config.ts) — an invalid value refuses the app to start with a
# clear error instead of failing confusingly later. staging and production
# are treated as one strict profile: DATABASE_URL and CORS_ORIGIN have no
# default there and must be set explicitly.

# development | test | staging | production
NODE_ENV=development

# HTTP server bind address and port. PORT must be an integer, 1-65535.
HOST=0.0.0.0
PORT=3000

# Logger level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Allowed browser origins for CORS (comma-separated). Matches the frontend dev
# server in development. Required (no default) in staging/production.
CORS_ORIGIN=http://localhost:5173

# Postgres connection string (postgres:// or postgresql://).
# Required (no default) in staging/production — the app refuses to start
# there without one, and refuses this exact local placeholder too.
# Development/test fall back to these same local placeholder credentials when
# unset — not secrets, just a convention F-008's Docker Compose setup matches.
DATABASE_URL=postgresql://lca_lms:lca_lms_dev@localhost:5432/lca_lms_dev

# Redis (redis:// or rediss://) for sessions and login throttling (F-103).
# Required (no default) in staging/production. Development/test fall back to
# F-008's Compose Redis at redis://localhost:6379.
REDIS_URL=redis://localhost:6379

# Session cookie `Secure` flag (F-103). true = cookie named __Host-lca_sid,
# sent only over HTTPS (browsers treat http://localhost as secure, so the Vite
# dev proxy works). Set false only for a plain-http dev setup that isn't
# localhost; staging/production refuse false.
# SESSION_COOKIE_SECURE=true

# Which reverse-proxy hops to trust for the client IP (X-Forwarded-For), which
# the login throttle keys on. false (default) = the socket address. Behind a
# proxy set a hop count (e.g. 1) or the proxy addresses/CIDRs
# (e.g. 10.0.0.0/8). "true" is refused: any client could pick its own IP.
# TRUST_PROXY=false

# argon2id password-hashing cost (F-102). Defaults are the OWASP minimum
# profile (19 MiB, 2 iterations, 1 lane); staging/production refuse anything
# below that floor. Raise them if the server can afford ~50-100ms per hash.
# Existing hashes keep verifying after a change; needsRehash() lets login
# (F-103) upgrade them.
# PASSWORD_HASH_MEMORY_KIB=19456
# PASSWORD_HASH_TIME_COST=2
# PASSWORD_HASH_PARALLELISM=1

# First-admin seeding (`npm run db:seed:admin`, F-008). Read only by the seed
# script, never by the app. Leave commented out here; prefer passing them
# inline for the one run rather than persisting a password in backend/.env.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=<passphrase meeting the password policy, 12-128 chars>
# SEED_ADMIN_NAME=Administrator
