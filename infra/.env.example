# LCA LMS — local service credentials for docker compose (F-008).
#
# Copy to infra/.env to override any of the defaults (e.g. a port already in
# use). Local development only — never used for staging or production.
#
# The values below are also the defaults baked into docker-compose.yml and the
# backend's zero-config fallback, so an empty/absent infra/.env is fine.

POSTGRES_USER=lca_lms
POSTGRES_PASSWORD=lca_lms_dev
POSTGRES_DB=lca_lms_dev
POSTGRES_PORT=5432

REDIS_PORT=6379
